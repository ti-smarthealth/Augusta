{
  "expo": {
    "name": "tisoft-app",
    "slug": "tish",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tisoftapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone for voice dictation.",
        "NSPhotoLibraryUsageDescription": "$(PRODUCT_NAME) does not use your photo library. This notice is required because an image component in the app is capable of loading photos from it.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "bundleIdentifier": "com.ti-smarthealth.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mcha2910.tish"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice dictation.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to use speech recognition to convert your voice to text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-audio",
      "expo-asset",
      "expo-notifications",
      [
        "./plugins/with-platform-sounds",
        {
          "ios": [
            "./assets/sounds/alarm_coffee_time.caf",
            "./assets/sounds/alarm_digital_bounce.caf",
            "./assets/sounds/alarm_good_morning_melody.caf",
            "./assets/sounds/alarm_mission_start.caf",
            "./assets/sounds/alarm_morning_chime.caf",
            "./assets/sounds/alarm_ready_set_go.caf",
            "./assets/sounds/alarm_sunrise_spark.caf",
            "./assets/sounds/alarm_wake_up_steps.caf"
          ],
          "android": [
            "./assets/sounds/alarm_coffee_time.ogg",
            "./assets/sounds/alarm_digital_bounce.ogg",
            "./assets/sounds/alarm_good_morning_melody.ogg",
            "./assets/sounds/alarm_mission_start.ogg",
            "./assets/sounds/alarm_morning_chime.ogg",
            "./assets/sounds/alarm_ready_set_go.ogg",
            "./assets/sounds/alarm_sunrise_spark.ogg",
            "./assets/sounds/alarm_wake_up_steps.ogg"
          ]
        }
      ],
      "./plugins/with-exact-alarms"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a11811b1-26d3-41e6-95ba-06330cec94f0"
      }
    },
    "owner": "mcha2910",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a11811b1-26d3-41e6-95ba-06330cec94f0"
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "zh-Hant": "./locales/ios/zh-Hant.json"
    }
  }
}
